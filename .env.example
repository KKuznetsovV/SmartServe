# Root .env.example — values shared between services in Docker Compose
# Copy to .env (gitignored) and adjust as needed

# Shared backend secrets (consumed by every services/* app via env_file)
SECRET_KEY=replace-with-openssl-rand-hex-32

# SQLAlchemy pool per service. Defaults are 5 + 5 overflow; seven services then use at
# most 70 connections, under Postgres' default max_connections of 100.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Anthropic (used by AI assistant)
ANTHROPIC_API_KEY=

# Optional local GGUF for the ai service. Leave empty to skip the on-device model.
LOCAL_MODEL_PATH=
# LOCAL_MODEL_DIR=./models

# Web app (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ORDERS_URL=http://localhost:3001
