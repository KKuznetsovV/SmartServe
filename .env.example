# Root .env.example — values shared between services in Docker Compose
# Copy to .env (gitignored) and adjust as needed

# API service secrets (also copy apps/api/.env.example → apps/api/.env)
SECRET_KEY=replace-with-openssl-rand-hex-32

# Anthropic (used by AI assistant)
ANTHROPIC_API_KEY=

# Web app (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000
