# Root .env.example — values shared between services in Docker Compose
# Copy to .env (gitignored) and adjust as needed

# Shared backend secrets (consumed by every services/* app via env_file)
SECRET_KEY=replace-with-openssl-rand-hex-32

# Anthropic (used by AI assistant)
ANTHROPIC_API_KEY=

# Web app (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ORDERS_URL=http://localhost:3001
